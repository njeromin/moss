set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

find_program(OS_CLANG NAMES clang REQUIRED)
set(CMAKE_C_COMPILER "${OS_CLANG}")
set(CMAKE_ASM_COMPILER "${OS_CLANG}")
set(CMAKE_C_COMPILER_TARGET "${OS_TARGET_TRIPLE}")
set(CMAKE_ASM_COMPILER_TARGET "${OS_TARGET_TRIPLE}")

# Host programs may be used, but host packages/libraries must not leak in.
set(CMAKE_FIND_ROOT_PATH "${CMAKE_BINARY_DIR}/sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
